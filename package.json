{
  "name": "tadasaposys",
  "version": "1.14.0",
  "description": "タダサポ管理システム — E2E テスト",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:a11y": "playwright test tests/e2e/07-a11y.spec.ts",
    "test:unit": "jest",
    "test:unit:cov": "jest --coverage",
    "test:all": "jest && playwright test",
    "build": "node tools/build.js",
    "deploy": "node tools/deploy.js",
    "check": "node tools/check-sync.js",
    "check:strict": "node tools/check-sync.js --strict",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.10",
    "jest": "^29.7.0",
    "lucide-react": "0.330.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.3"
  }
}
